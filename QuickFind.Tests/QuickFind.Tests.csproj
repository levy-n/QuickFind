<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Tests reference the main QuickFind project, which targets
      net8.0-windows (WPF). Tests themselves don't touch WPF types,
      but the TFM has to be compatible with the reference.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickFind\QuickFind.csproj" />
  </ItemGroup>

</Project>
